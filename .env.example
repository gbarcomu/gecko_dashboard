# CoinGecko Demo (free) API key.
# Get one at https://www.coingecko.com/en/developers/dashboard
# The free tier uses the "Demo" key, sent via the x-cg-demo-api-key header.
COINGECKO_API_KEY=

# Optional overrides
# COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Path to the SQLite file (relative to project root)
# DATABASE_PATH=data/gecko.db
